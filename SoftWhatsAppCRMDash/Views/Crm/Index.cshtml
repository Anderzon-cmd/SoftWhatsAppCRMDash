@model Cliente
@{
    ViewData["Title"] = "Pagina de Dashboard crm";
}
<div class="grid-cols-3 grid gap-4">
    <div class="flex flex-col gap-4" style="height:20rem">

        <input id="number-client" hidden value="@Model.Numero.Substring(Model.Numero.Length - 8)" />
        <div class="h-full rounded-lg bg-white p-4 text-center shadow">
            <h2 class="mb-4 text-xl font-bold">Promedio Cliente</h2>
            <p id="time-client" class="text-3xl font-bold">0 (s/m)</p>
        </div>


        <div class="h-full rounded-lg bg-white p-4 text-center shadow">
            <h2 class="mb-4 text-xl font-bold">Promedio Respuesta</h2>
            <p id="time-response" class="text-3xl font-bold">0 (s/m)</p>
        </div>

    </div>

    <div id="container-nouns" style="height:20rem" class="border border-gray-200"></div>
    <div id="container-verbs" style="height:20rem" class="border border-gray-200"></div>
    <div id="container-entities" style="height:20rem" class="border border-gray-200"></div>
    
</div>


@section Scripts {
    <script src="~/lib/highcharts/highcharts.js"></script>
    <script src="~/js/const.js"></script>
    <script src="~/js/crm/crm.js"></script>
    <script src="/js/crm/index.js"></script>
}
