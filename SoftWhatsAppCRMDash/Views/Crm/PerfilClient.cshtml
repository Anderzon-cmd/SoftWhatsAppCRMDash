@model string
@{
    ViewData["Title"] = "Perfil del Cliente";
}

<section class="bg-white dark:bg-gray-900">
    <div class="mx-auto max-w-screen-md px-4 py-8 lg:py-16">
        <h2 class="mb-4 text-center text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">Perfil del cliente</h2>
        
        <form asp-action="Update" class="space-y-8" method="post">
            
            <div class="sm:col-span-2">
                <label for="message" class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-400">Pefil</label>
                <textarea rows="18" class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 shadow-sm focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" placeholder="comportamiento..." name="comportamiento">@Model</textarea>
                

            </div>
        </form>
    </div>
</section>

@section Scripts {

}