@model LoginVM
@{
    Layout="_LoginLayout";
}
<section class="bg-gray-50 dark:bg-gray-900">
    <div class="mx-auto flex flex-col items-center justify-center px-6 py-8 md:h-screen lg:py-0">
        <a href="#" class="mb-6 flex items-center text-2xl font-semibold text-gray-900 dark:text-white">
            <img class="mr-2 h-8 w-8" src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/logo.svg" alt="logo">
            Dash CRM
        </a>
        <div class="w-full rounded-lg bg-white shadow dark:border dark:bg-gray-800 dark:border-gray-700 sm:max-w-md md:mt-0 xl:p-0">
            <div class="space-y-4 p-6 sm:p-8 md:space-y-6">
                <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 dark:text-white md:text-2xl">
                    Inicia session en tu cuenta
                </h1>
                <form class="space-y-4 md:space-y-6" asp-action="Login" asp-controller="Account" method="post" >
                    <div>
                        <label asp-for="Email" class="mb-2 block text-sm font-medium text-gray-900 dark:text-white">Correo</label>
                        <input type="email" asp-for="Email" id="email" class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 focus:ring-primary-600 focus:border-primary-600 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" placeholder="name@company.com" >
                        
                        <span asp-validation-for="Email" class="text-red-500"></span>
                    </div>


                    <div>
                        <label asp-for="Password" class="mb-2 block text-sm font-medium text-gray-900 dark:text-white">Correo</label>
                        <input type="password" asp-for="Password" id="password" class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 focus:ring-primary-600 focus:border-primary-600 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" placeholder="**********">
                        <span asp-validation-for="Password" class="text-red-500"></span>
                    </div>
                    @Html.ValidationSummary(true, "", new { @class = "text-red-500" })

                    <div class="flex items-center justify-between">
                        <div class="flex items-start">
                            <div class="flex h-5 items-center">
                                <input id="RememberMe" aria-describedby="remember" asp-for="RememberMe" type="checkbox" class="h-4 w-4 rounded border border-gray-300 bg-gray-50 focus:ring-3 focus:ring-primary-300 dark:bg-gray-700 dark:border-gray-600 dark:ring-offset-gray-800 dark:focus:ring-primary-600">
                            </div>
                            <div class="ml-3 text-sm">
                                <label asp-for="RememberMe" class="text-gray-500 dark:text-gray-300">Recordar</label>
                            </div>
                        </div>
                        <a href="#" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-500">Olvide mi contrasena?</a>
                    </div>
                    <button type="submit" class="w-full rounded-lg bg-blue-600 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-primary-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Ingresar</button>
                    <p class="text-sm font-light text-gray-500 dark:text-gray-400">
                        Don’t have an account yet? <a href="#" class="text-primary-600 font-medium hover:underline dark:text-primary-500">Sign up</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}